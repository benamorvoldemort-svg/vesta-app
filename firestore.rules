rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ───────────────────────────────────────────────
    function isAuth() {
      return request.auth != null;
    }

    function userData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isAuth() && userData().role == 'admin';
    }

    function isOwner(uid) {
      return isAuth() && request.auth.uid == uid;
    }

    // Active prestataire: role == prestataire AND status == active
    function isActivePrestataire() {
      return isAuth()
        && userData().role == 'prestataire'
        && userData().status == 'active';
    }

    // ── Users ─────────────────────────────────────────────────
    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();

      allow create: if isOwner(uid);

      // Owner can update own profile, but role and uid are immutable
      allow update: if (isOwner(uid)
          && request.resource.data.role == resource.data.role
          && request.resource.data.uid  == resource.data.uid)
        || isAdmin();

      allow delete: if isAdmin();
    }

    // ── Bookings ──────────────────────────────────────────────
    match /bookings/{bookingId} {

      // Read rules:
      // - Admin reads everything
      // - Client reads their own bookings
      // - Prestataire reads bookings assigned to them
      // - Active prestataire reads ALL bookings (needed for listenAvailableBookings query)
      allow read: if isAdmin()
        || (isAuth() && resource.data.clientId == request.auth.uid)
        || (isAuth() && resource.data.workerId == request.auth.uid)
        || isActivePrestataire();

      // Only clients can create a booking for themselves
      allow create: if isAuth()
        && request.resource.data.clientId == request.auth.uid
        && userData().role == 'client';

      // Client can update their own booking (cancel, stop recurrence)
      allow update: if isAuth()
        && resource.data.clientId == request.auth.uid
        && request.resource.data.clientId == resource.data.clientId;

      // Active prestataire can accept, start, complete, upload photos
      allow update: if isActivePrestataire();

      // Admin can update or delete anything
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ── Messages (subcollection of bookings) ──────────────────
    match /bookings/{bookingId}/messages/{msgId} {
      allow read, write: if isAuth() && (
        isAdmin()
        || get(/databases/$(database)/documents/bookings/$(bookingId)).data.clientId  == request.auth.uid
        || get(/databases/$(database)/documents/bookings/$(bookingId)).data.workerId  == request.auth.uid
      );
    }

    // ── Reviews ───────────────────────────────────────────────
    match /reviews/{reviewId} {
      allow read: if isAuth();

      allow create: if isAuth()
        && request.resource.data.clientId == request.auth.uid;

      allow update, delete: if isAdmin();
    }

    // ── FCM Tokens ────────────────────────────────────────────
    match /fcmTokens/{uid} {
      allow read, write: if isOwner(uid) || isAdmin();
    }

  }
}
